{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tle-os",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3200
    },
    {
      "name": "tle-os-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:alt"
      ],
      "port": 3220
    },
    {
      "name": "tle-os-radar",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgres://postgres:radar@localhost:55432/tleos",
        "NEXT_DIST_DIR=.next-radar",
        "npx",
        "next",
        "dev",
        "-p",
        "3280"
      ],
      "port": 3280
    }
  ]
}
