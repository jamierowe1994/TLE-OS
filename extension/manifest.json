{
  "manifest_version": 3,
  "name": "TLE OS for Propoly",
  "short_name": "TLE OS",
  "version": "0.1.0",
  "description": "Shows The Letting Experts' agents whether the Propoly deal on screen is in TLE OS, with a link straight to the let.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TLE OS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://tle-os.co.uk/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://tle.propoly.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
